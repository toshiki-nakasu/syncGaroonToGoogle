{
    "name": "sync-garoon-to-google-development",
    "private": true,
    "engines": {
        "node": ">=24 <25"
    },
    "scripts": {
        "setup": "bash script/environment/setup-development.sh",
        "test": "npm --prefix chrome-extension test && npm run test:release && bash script/test/test-documentation.sh",
        "check": "npm --prefix chrome-extension run check && find script .github/script gas/script -type f -name '*.sh' -print0 | xargs -0 -r -n 1 bash -n && bash script/documentation/check-links.sh",
        "test:release": "bash script/test/test-release.sh",
        "package:extension": "bash script/release/build-extension.sh",
        "release:tag": "bash script/release/tag-and-push.sh",
        "format": "prettier --write",
        "format:check": "prettier --check",
        "browser:install": "playwright install --no-shell chromium",
        "browser:install:deps": "playwright install --with-deps --no-shell chromium",
        "test:browser": "node --test chrome-extension/test/browser/*.test.js"
    },
    "devDependencies": {
        "@google/clasp": "3.4.1",
        "playwright": "1.64.1",
        "prettier": "3.9.10"
    }
}
