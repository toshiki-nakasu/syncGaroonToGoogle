{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "git: Tag & Push Extension Release",
            "type": "process",
            "command": "bash",
            "args": ["script/release/tag-and-push.sh", "${input:version}"],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "panel": "new"
            }
        },
        {
            "label": "release: Build Extension ZIP (Local)",
            "type": "process",
            "command": "bash",
            "args": [
                "script/release/build-extension.sh",
                "${input:packageTag}",
                "${input:repository}"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "panel": "new"
            }
        },
        {
            "label": "VSCode: Install Recommended Extensions",
            "type": "shell",
            "command": "bash",
            "args": [
                "-c",
                "cat .vscode/extensions.json | jq -r '.recommendations[]' | xargs -I {} code --install-extension {}"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [],
            "group": "none",
            "presentation": {
                "reveal": "always",
                "panel": "new"
            }
        }
    ],
    "inputs": [
        {
            "id": "version",
            "type": "promptString",
            "description": "Chrome拡張機能のリリース番号 (例: 1.0.0 または v1.0.0)",
            "default": "0.1.0"
        },
        {
            "id": "packageTag",
            "type": "promptString",
            "description": "ZIPの生成用タグ名 (例: v1.2.3。Gitタグの存在は不要で、タグ作成とpushは行わない)",
            "default": "v0.1.0"
        },
        {
            "id": "repository",
            "type": "promptString",
            "description": "配布物の更新元リポジトリ (owner/repository形式)",
            "default": "toshiki-nakasu/syncGaroonToGoogle"
        }
    ]
}
